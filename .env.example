# ---------------------------------------------------------------------
# Supabase — Project Settings -> API in your Supabase dashboard
# ---------------------------------------------------------------------
# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# service_role secret. Server-only: it bypasses RLS, so it must never be
# prefixed NEXT_PUBLIC_ and never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------
# Session signing
# ---------------------------------------------------------------------
# At least 32 characters. Generate with: openssl rand -base64 32
# Changing this signs everyone out.
SESSION_SECRET=

# ---------------------------------------------------------------------
# Address lookup
# ---------------------------------------------------------------------
# Google Places gives clean, street-level suggestions and is strongly
# recommended. Leave this blank and the app falls back to OpenStreetMap
# Nominatim, which is free but noticeably vaguer.
#
# To get one: console.cloud.google.com -> create a project -> enable
# "Places API (New)" and "Geocoding API" -> Credentials -> Create API key.
# Billing must be enabled; Google's free monthly credit covers a laundromat's
# volume many times over. Restrict the key to those two APIs.
#
# Server-side only — never prefix this NEXT_PUBLIC_.
GOOGLE_MAPS_API_KEY=

# Countries the portal accepts addresses from (ISO 3166-1 alpha-2,
# comma-separated). Enforced on BOTH the suggestion dropdown and the
# submit-time geocode, so a foreign address cannot be typed in by hand either.
# Applies to whichever provider is active. Blank allows anywhere.
ADDRESS_COUNTRY_CODES=us

# Only used by the Nominatim fallback: their policy asks that you identify
# your app and give a contact address.
GEOCODER_USER_AGENT=LaundromatPortal/1.0 (you@example.com)

# IANA timezone the laundromat operates in. Controls what counts as
# "today" for scheduling and the admin dashboard. Defaults to the server's
# timezone, which is UTC on most hosts — set this explicitly in production.
NEXT_PUBLIC_APP_TIMEZONE=America/New_York
