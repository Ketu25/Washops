{
  "$schema": "node_modules/wrangler/config-schema.json",

  // MUST match the Cloudflare Worker this deploys to. OpenNext adds a
  // WORKER_SELF_REFERENCE service binding pointing at this name; if it does
  // not match the deployed Worker, the API rejects the upload with
  // "references Worker '<name>' which was not found" [code: 10143].
  "name": "washnexos",

  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-07",

  // Required by OpenNext: the server bundle uses Node built-ins.
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  // Password hashing is deliberately expensive. bcryptjs is pure JavaScript,
  // so a cost-12 hash burns a few hundred milliseconds of CPU — far past the
  // 10ms free-plan ceiling, and past the 30s default only under load. This
  // raises the ceiling on paid plans; on the free plan, sign-in and
  // registration will exceed CPU limits regardless of this setting.
  "limits": {
    "cpu_ms": 60000
  }
}
