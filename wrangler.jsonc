{
  "$schema": "node_modules/wrangler/config-schema.json",

  // MUST match the Cloudflare Worker this deploys to. OpenNext adds a
  // WORKER_SELF_REFERENCE service binding pointing at this name; if it does
  // not match the deployed Worker, the API rejects the upload with
  // "references Worker '<name>' which was not found" [code: 10143].
  "name": "washnexos",

  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-07",

  // Required by OpenNext: the server bundle uses Node built-ins.
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  // Environment variables live in the Cloudflare dashboard, not here, so the
  // repo stays free of project-specific values. By default `wrangler deploy`
  // treats this file as the whole truth and DELETES any dashboard var it does
  // not declare — which would wipe the Supabase and Google credentials on
  // every deploy and break the app at runtime. This keeps them.
  //
  // Secrets (set as type "Secret") are stored separately and survive deploys
  // regardless; this flag is what protects plain-text vars.
  "keep_vars": true

  // NOTE: no "limits.cpu_ms" here. Setting it fails the deploy outright on
  // the Free plan ("CPU limits are not supported for the Free plan"
  // [code: 100328]). See the README for why bcrypt still needs attention on
  // that plan — the limit is the symptom, not something config can fix.
}
